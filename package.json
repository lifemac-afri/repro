{
  "name": "repro",
  "version": "1.0.0",
  "description": "Office Receipt Scanner and Processing Management System",
  "main": "server/index.js",
  "scripts": {
    "start": "node -e \"const fs=require('fs'); if(!fs.existsSync('dist/index.html')) { console.log('⚡ Building frontend bundle...'); require('child_process').execSync('npm run build', {stdio:'inherit'}); }\" && node server/index.js",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"cyan,magenta\" \"npm run server\" \"npm run client\"",
    "server": "cross-env PORT=3001 node server/index.js",
    "client": "vite",
    "build": "vite build",
    "preview": "vite preview"
  },
  "keywords": [
    "receipt-scanner",
    "office-expenses",
    "ocr",
    "tax-accounting"
  ],
  "author": "",
  "license": "ISC",
  "type": "module",
  "dependencies": {
    "archiver": "^7.0.1",
    "canvas-confetti": "^1.9.4",
    "concurrently": "^9.1.2",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "lucide-react": "^1.16.0",
    "multer": "^1.4.5-lts.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sql.js": "^1.14.2",
    "tesseract.js": "^5.1.1",
    "uuid": "^11.1.0"
  },
  "optionalDependencies": {
    "better-sqlite3": "^11.8.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "cross-env": "^7.0.3",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "vite": "^6.1.0"
  }
}
